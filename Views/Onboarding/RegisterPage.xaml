<Page x:Class="WPF_Student_Portal.Views.Onboarding.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_Student_Portal.Views.Onboarding"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage"
      Background="White">

    <Grid>
        <Border Background="#F5F5F5" Width="Auto" Height="Auto" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
            <StackPanel Orientation="Vertical">
                <Border HorizontalAlignment="Left">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="New student form" FontWeight="Bold" FontFamily="Inter" FontSize="20" Height="Auto"></TextBlock>
                        <TextBlock Text="Fill in the fields to enroll a new student." FontWeight="Light" FontSize="10" Foreground="#605F5F"></TextBlock>
                    </StackPanel>
                </Border>

                <GroupBox BorderBrush="#D3D3D3" HorizontalAlignment="Stretch" BorderThickness="1" Margin="20">
                    <GroupBox.Header>
                        <TextBlock Text="Personal information" 
                                   FontFamily="Inter"
                                   FontStyle="Normal"
                                   FontSize="12"
                                   Height="Auto"
                                   FontWeight="Normal" 
                                   HorizontalAlignment="Left"
                                   Foreground="#333333" 
                                   Padding="5,0"/>
                    </GroupBox.Header>

                    <Grid>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </Border>
    </Grid>
</Page>
