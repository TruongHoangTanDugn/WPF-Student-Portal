<Page x:Class="WPF_Student_Portal.Views.Onboarding.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_Student_Portal.Views.Onboarding"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage"
      >

    <Grid Background="White">
        <Border Height="Auto" Width="290" Padding="20" Background="#F5F5F5"
            VerticalAlignment="Center">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                
                <Border Height="Auto" Width="142" HorizontalAlignment="Left"> 
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Student Portal" FontWeight="Bold" FontFamily="Inter" FontSize="20" Height="Auto"></TextBlock>
                        <TextBlock Text="Please enter your credentials" FontFamily="Inter" FontWeight="Light" FontSize="10" Height="Auto"> </TextBlock>
                    </StackPanel>
                </Border>

                <Border Height="Auto" HorizontalAlignment="Stretch" Margin="0, 15, 0, 15">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Username" Foreground="#000000" FontFamily="Inter" FontWeight="Regular" FontStyle="Normal" FontSize="12" Height="Auto"></TextBlock>
                        <Border CornerRadius="5" BorderBrush="#9A9A9A" BorderThickness="0.5" Background="White">
                            <TextBox BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextChanged="TextBox_TextChanged" ></TextBox>
                        </Border>
                        
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Stretch" Height="Auto">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Password" FontFamily="Inter" FontWeight="Regular" FontStyle="Normal" FontSize="12" Height="Auto" Foreground="#000000"></TextBlock>
                        <Border CornerRadius="5" BorderBrush="#9A9A9A" BorderThickness="0.5" Background="White">
                            <TextBox BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextChanged="TextBox_TextChanged" ></TextBox>
                        </Border>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Stretch" Height="Auto" Margin="0, 15, 0, 0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear" FontWeight="Regular" FontStyle="Normal" Height="Auto" FontSize="12" Foreground="#000000" Width="Auto" Background="#D4EFFD" BorderBrush="#9A9A9A" Padding="15,4,15,4" Margin="0, 0, 15, 0"></Button>
                        <Button Content="Login" Background="#1FA8F2" Foreground="#FFFFFF" FontSize="12" FontFamily="Inter" FontWeight="Regular" FontStyle="Normal" Padding="15, 4, 15, 4" Height="Auto" Width="Auto"></Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        
        
    </Grid>
</Page>
