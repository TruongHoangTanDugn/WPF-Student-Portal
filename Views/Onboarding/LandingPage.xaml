<Page x:Class="WPF_Student_Portal.Views.Onboarding.LandingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_Student_Portal.Views.Onboarding"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LandingPage"
      Background="AntiqueWhite">

    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="LoginButton" Content="Login" Background="LawnGreen" Foreground="Black" FontWeight="Bold" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding LoginCommand}"></Button>
            <Button x:Name="RegisterButton" Content="Register" Background="Blue" Foreground="Black" FontWeight="Bold" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0" Command="{Binding RegisterCommand}"></Button>
        </StackPanel>
    </Grid>
</Page>
