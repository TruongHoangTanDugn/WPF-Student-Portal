<Page x:Class="BTTuan005_StudentPortal.Views.OnBoarding.StartingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BTTuan005_StudentPortal.Views.OnBoarding"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StartingPage">

    <Grid Background="White">
        <Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="LoginButton" Content="Log in" FontSize="50" Height="100" Width="200" 
                        Background="Green" Margin="20"/>
                <Button x:Name="SignUpButton" Content="Sign up" FontSize="50" Height="100" Width="200"
                        Background="Red"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
