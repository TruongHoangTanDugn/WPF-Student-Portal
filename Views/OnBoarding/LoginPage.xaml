<Page x:Class="BTTuan005_StudentPortal.Views.OnBoarding.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LoginPage" MinHeight="450" MinWidth ="800">

    <Grid Background="White">
        <Border HorizontalAlignment="Center" Padding="20" VerticalAlignment="Center" Background="#F5F5F5">
            <StackPanel Orientation="Vertical" Width="Auto" Height="Auto" HorizontalAlignment="Left">
                <!--Title-->
                <StackPanel Height="Auto" Width="Auto" HorizontalAlignment="Left">
                    <TextBlock Width="142" Height="Auto" HorizontalAlignment="Left"
                               Text="Student Portal" FontFamily="Inter" Foreground="#000000" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Width="Auto" Height="Auto" HorizontalAlignment="Left"
                               Text="Please enter your credentials" Foreground="#605F5F" FontSize="12"/>
                </StackPanel>

                <!--Username-->
                <StackPanel Width="142" Height="Auto" HorizontalAlignment="Left" Margin="0,5,0,0">
                    <TextBlock Text="Username" FontFamily="Inter" FontSize="12" FontWeight="DemiBold"/>
                    <Border BorderThickness="0.5" CornerRadius="5" BorderBrush="#9A9A9A">
                        <TextBox BorderThickness="0" 
                                 Background="Transparent" 
                                 Height="21" Width="250"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                </StackPanel>

                <!--Password-->
                <StackPanel Width="142" Height="Auto" 
                            HorizontalAlignment="Left" Margin="0,5,0,0">
                    <TextBlock Text="Password" FontFamily="Inter" 
                               FontSize="12" FontWeight="DemiBold"/>
                    <Border BorderThickness="0.5" 
                            CornerRadius="5" 
                            BorderBrush="#9A9A9A">
                        <PasswordBox BorderThickness="0" 
                                     Background="Transparent" 
                                     Height="21" Width="250"/>
                    </Border>
                </StackPanel>

                <!--Buttons-->
                <Border Height="Auto" HorizontalAlignment="Stretch" Margin="15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear" Background="#D4EFFD" Margin="0,0,10,0"/>
                        <Button Content="Login" Background="#1FA8F2" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>
