<Page x:Class="BTTuan005_StudentPortal.Views.Home.StudentFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BTTuan005_StudentPortal.Views.Home"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StudentFormPage">

    <Grid Background="#F5F5F5">
        <Border HorizontalAlignment="Center" Padding="0" VerticalAlignment="Center" Background="#F5F5F5">

            <StackPanel Orientation="Vertical" Width="Auto" Height="Auto" HorizontalAlignment="Left">
                <StackPanel>
                    <!--Title-->
                    <TextBlock Width="179" Height="24" HorizontalAlignment="Left" Margin="0,0,0,10"
                                Text="Student Form" FontFamily="Inter" Foreground="#000000" FontSize="20" FontWeight="Bold"/>

                    <!--Register section-->
                    <StackPanel>
                        <!--Personal information-->
                        <GroupBox Style="{StaticResource RoundedGroupBox}"
                              Header="Personal information"
                              HorizontalAlignment="Stretch"
                              Height="Auto"
                              Margin="0,10,0,10">
                            <StackPanel Orientation="Vertical">
                                <!--Name-->
                                <Grid Margin="0,5,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!--First name-->
                                    <StackPanel Orientation="Vertical" Grid.Column="0">
                                        <TextBlock Text="First name"/>
                                        <Border BorderThickness="0.5" CornerRadius="5" 
                                            BorderBrush="#9A9A9A" Margin="0,0,10,0">
                                            <TextBox BorderThickness="0" Background="Transparent" 
                                                 Height="21" Width="Auto"
                                                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Border>
                                    </StackPanel>
                                    <!--Last name-->
                                    <StackPanel Orientation="Vertical" Grid.Column="1">
                                        <TextBlock Text="Last name"/>
                                        <Border BorderThickness="0.5" CornerRadius="5" BorderBrush="#9A9A9A">
                                            <TextBox BorderThickness="0" Background="Transparent" 
                                                 Height="21" Width="Auto"
                                                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!--Email-->
                                <StackPanel Orientation="Vertical" Margin="0,5,0,5">
                                    <TextBlock Text="Contact email"/>
                                    <Border BorderThickness="0.5" CornerRadius="5" BorderBrush="#9A9A9A">
                                        <TextBox BorderThickness="0" Background="Transparent" 
                                             Height="21" Width="Auto"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Border>
                                </StackPanel>

                                <!--Gender-->
                                <StackPanel Orientation="Vertical" Margin="0,5,0,5">
                                    <TextBlock Text="Gender"/>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,3,0">
                                            <RadioButton BorderBrush="#000000" BorderThickness="0.5" 
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="Male" Height="Auto" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="3,0,3,0">
                                            <RadioButton BorderBrush="#000000" BorderThickness="0.5" 
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="Female" Height="Auto" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="3,0,3,0">
                                            <RadioButton BorderBrush="#000000" BorderThickness="0.5" 
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="Other" Height="Auto" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!--Academic Details-->
                        <GroupBox Style="{StaticResource RoundedGroupBox}"
                              Header="Academic Details"
                              Margin="0,10,0,10">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Major"/>
                                <Border BorderThickness="0.5" CornerRadius="6" BorderBrush="#9A9A9A" Padding="4" Margin="0,6,0,0">
                                    <!-- bind ItemsSource to a viewmodel collection (see notes) -->
                                    <ComboBox BorderThickness="0"
                                            Background="Transparent"
                                            MinWidth="300"
                                            Height="12"
                                            FontSize="12"
                                            Padding="10,0"
                                            ItemsSource="{Binding Majors}"
                                            SelectedItem="{Binding SelectedMajor, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        
                        <!--Buttons-->
                        <Border Height="Auto" HorizontalAlignment="Stretch" Margin="15">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Close" Background="#D4EFFD" Margin="0,0,10,0"/>
                                <Button Content="Add" Background="#1FA8F2" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
