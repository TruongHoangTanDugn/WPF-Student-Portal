<Application x:Class="BTTuan005_StudentPortal.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BTTuan005_StudentPortal"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style x:Key="RoundedGroupBox" TargetType="GroupBox">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#9A9A9A"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <!-- outer rounded frame -->
                            <Border x:Name="Bd"
                                    CornerRadius="5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True" />

                            <!-- main content placed inside the frame; leave room at top for header -->
                            <ContentPresenter Margin="12,16,12,12"
                                              ContentSource="Content" />

                            <!-- header overlay that sits on top of the border stroke -->
                            <Border Background="#F5F5F5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="16,-12,0,0"
                                    Padding="0"
                                    Panel.ZIndex="1">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
